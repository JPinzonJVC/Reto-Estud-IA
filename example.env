# Configuración del entorno de la aplicación
APP_NAME=Reto-Estud-IA
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Configuración de Base de Datos PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=estudia_db
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/estudia_db

# Directorio local de insumos de datos (.csv / .parquet)
INPUT_DIR=./input

# =============================================================
# Orquestación Prefect y Scheduler (semanal por defecto)
# =============================================================
PREFECT_API_URL=http://localhost:4200/api
# Cron de 5 campos (por defecto lunes 06:00 AM). Ej. diario: "0 6 * * *"
EDA_SCHEDULE_CRON=0 6 * * 1
EDA_SCHEDULE_TIMEZONE=America/Bogota
EDA_DEPLOYMENT_NAME=eda-medallion-weekly
EDA_FORCE_REPROCESS=false
EDA_CLEANUP_RAW_AFTER_LOAD=true

# =============================================================
# Extractor Google Drive (Excel / CSV)
# =============================================================
GDRIVE_ENABLED=false
GDRIVE_FOLDER_ID=
GDRIVE_CREDENTIALS_FILE=./secrets/gdrive-sa.json
GDRIVE_DOWNLOAD_DIR=./input/raw_drive
GDRIVE_EXPORT_XLSX_TO_CSV=true
DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# =============================================================
# Extractor Zoho CRM (OAuth2 incremental)
# =============================================================
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_MODULES=Accounts,Contacts,Deals
ZOHO_OUTPUT_DIR=./input/raw_zoho
